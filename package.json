{
  "name": "tamadun-kota",
  "private": true,
  "version": "2.0.0",
  "description": "Tamadun & Kota: Sejarah Malaysia - an isometric city-building and era-progression strategy game set in Malaysian history.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vite build && node e2e/smoke.mjs && node e2e/soak3d.mjs",
    "screenshots": "vite build && node e2e/shot.mjs docs/screenshots && node e2e/eras.mjs docs/screenshots && node e2e/shots3d.mjs docs/screenshots",
    "check": "npm run typecheck && npm run lint && npm test",
    "models:spec": "vite-node scripts/generate-glb.ts --spec-only",
    "models:node": "vite-node scripts/generate-glb.ts",
    "models:blender": "npm run models:spec && blender --background --factory-startup --python scripts/generate_blender_models.py -- --spec scripts/model_spec.json --out public/models",
    "e2e:smoke": "vite build && node e2e/smoke.mjs",
    "e2e:soak": "vite build && node e2e/soak3d.mjs",
    "unity:data": "vite-node scripts/export-unity-data.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
}
